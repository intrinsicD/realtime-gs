 "depends_on": [],
 "title": "Jet-consistency (Weingarten) prior for 3DGS training on TOSCA cat0 renders: normals, shell thickness, downstream Laplace-Beltrami accuracy",
 "question": "Does a closed-form shape-operator consistency loss on neighbouring splat normals and centres reduce normal noise and shell thickness during 3DGS training, and improve the SplatDiffuseLBO operator's spectrum against the mesh P2 reference, without degrading held-out appearance?",
 "hypothesis": "jet2 beats base in every paired seed: normal-angle median improves by >= 4 deg (target < 8 deg), centre-to-surface median by >= 30 %, held-out PSNR within -0.2 dB; jet1 (first-order control) improves less than jet2.",
 "claim_boundary": "Development screen on one synthetic object (TOSCA cat0 renders), three paired seeds, one lambda; a pass is a screening signal requiring a separately registered real-capture confirmation; no default promotion.",
 "evidence_phase": "development",
