 "preprocessing": {
  "downscale": 8,
  "undistort_full_resolution_first": true,
  "target_operator": "Field targets: rtgs.data.field_targets.decode_compact_view(downscale=8, supersample=2, backend=\"index\") of the 22 training views (exact CPU tile index); photograph targets: the same four edge-origin sites, bilinear grid_sample(align_corners=False) of the undistorted full-resolution photograph, clamped. The Trainer supervises target*mask + random_background*(1-mask) with L1 weight 0.1 + 0.9*mask; boundary pixels with fractional alpha include outside-mask target colour in proportion to the fraction (RTGS-025 B2).",
  "training_masks": "Soft packed-alpha fraction of each training view from the no_boundary compact views. prepare aborts unless each training view's packed alpha equals its thresholded lossless source mask, the compact view records the sealed photograph and mask SHA-256, and no training pixel with alpha > 0 lies outside the fit window.",
  "decoder_parity": "Per training view: 512 in-window sites from torch.Generator seed 926300 + training-view index; CPU index vs reference scan max abs <= 1e-5, else abort."
 },
 "initialization": {
  "n_points": 20000,
  "random": "20000 points uniform in the ball of radius 0.5 x extent about the bound center (object bounds from the 22 downscale-8 training cameras and their soft packed alpha >= 0.5), float64 draws from the paired seed, isotropic scale = mean nearest-neighbour distance, opacity 0.1, colour 0.5 gray; byte-identical across the six cells of a seed and digest-checked in each worker."
 },
 "opacity_reset": {
  "intended": "rtgs.optim.strategies.IntendedOpacityReset.from_density(config.density) passed as Trainer.train(parameter_step_callback=...): fires at gsplat iterations g with 0 < g < density.stop_iter and g % opacity_reset_every == 0 (8000 steps: g = 3000; 30000 steps: g = 3000, 6000, 9000, 12000), clamps opacity to 2 x prune_opacity and zeroes the opacity Adam moments. Events are recorded per cell.",
  "upstream": "No callback; gsplat 1.5.3 never resets (RTGS-027, O182) while opacity_reset_every still pauses refinement after each would-be reset and gates large-scale pruning onset."
 },
 "training": {
  "budgets": {
