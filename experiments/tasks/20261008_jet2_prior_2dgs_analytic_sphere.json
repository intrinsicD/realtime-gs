 "stages": [
  {
   "id": "prepare",
   "label": "Prepare",
   "purpose": "Verify the sealed v1 renders (160 pyrender views) and compute object bounds from the 128 training cameras and masks (v1 code path)."
  },
  {
   "id": "initialize",
   "label": "Initialization",
   "purpose": "The v1 seeded random initialization (20000 points), byte-identical to the v1 run's digests; its bbox diagonal must equal the frozen scene scale."
  },
  {
   "id": "fit",
   "label": "2DGS fitting",
   "purpose": "gsplat rasterization_2dgs surfels, identical Trainer configuration per arm; arms differ only in the anchor weight and the field-prior weight/terms, all of which switch on at step 7500, so every arm of a seed shares the schedule up to the h0 freeze. 15000 steps, densification 500-7500, SH 1, masks on. Displacement and gradient magnitudes, guarded fraction and collapse at activation logged."
  },
  {
   "id": "evaluate",
   "label": "Evaluation",
   "purpose": "Held-out PSNR/LPIPS/silhouette IoU (2DGS render); geometry against cat0.obj in fixed units for the opacity > 0.3 final subset and the frozen step-7500 cohort; coverage; signed displacement; collapse; flatness; splat-frame export; Zhou-Laehner spectrum. The SplatDiffuseLBO operator is the separate sequential operator stage."
  }
 ],
 "comparators": [
  {
   "id": "base",
   "label": "2DGS + distortion (0.01 D/s) + normal consistency 0.05 from 7500, no jet prior",
   "purpose": "Control."
  },
  {
   "id": "jet1",
   "label": "base + Jet2Prior order 1 (S = 0), lambda 0.1 from 7500",
   "purpose": "1-jet control: same neighbourhood, weights, gates and schedule."
  },
  {
   "id": "jet2",
   "label": "base + Jet2Prior order 2, lambda 0.1 from 7500",
   "purpose": "Treatment."
  }
 ],
