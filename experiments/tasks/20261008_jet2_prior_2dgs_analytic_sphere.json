   "unit": "fraction",
   "direction": "higher",
   "aggregation": "Fraction of 20000 area-sampled cat0.obj points (trimesh sample_surface, seed = the cell seed) with an opacity > 0.3 final centre within 0.5 h0-bar; h0-bar = mean frozen h0 over the step-7500 cohort."
  },
  {
   "id": "collapse_fraction",
   "label": "Collapse fraction (hard gate, any seed)",
   "unit": "fraction",
   "direction": "lower",
   "aggregation": "Share of all final splats with another splat closer than 0.05 h0_i; h0_i = mean distance to the 6 nearest centres at step 7500, identical rule in every arm. Also reported at activation (step 7500)."
  },
  {
   "id": "lbo_err_k10",
   "label": "SplatDiffuseLBO operator max_{k<=10} |lambda_k/lambda_k^P2 - 1|",
   "unit": "ratio",
   "direction": "lower",
   "aggregation": "b2 and jet, seed 9561, sequential CPU stage after the screen (8 h total): CAT_PLY=<cell>/gaussians_splat_frame.ply CAT_TAG=<task>/<arm>_9561 CAT_GUARD_MIN=<min(240, remaining)> python splat_lbo_cat.py v2 a; counts only if the companion's structural diagnostics pass (operator_stage.structural_limits)."
  }
 ],
