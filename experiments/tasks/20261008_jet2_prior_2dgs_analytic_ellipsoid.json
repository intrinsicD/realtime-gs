  "n_points": 20000,
  "random": "20000 points uniform in the ball of radius 0.5 x extent about the object-bound centre (rtgs.data.calibrated._object_bounds of the 128 training cameras and masks), float64 draws from the paired seed, isotropic scale = mean nearest-neighbour distance, opacity 0.1, colour 0.5 grey; byte-identical across the cells of a seed.",
  "reused_from": "none"
 },
 "training": {
  "configs": {
   "base": "15000 steps, gsplat-default densification 500-7500 every 100 (grad 2e-4, max 100000, opacity reset 3000 declared inert), SH degree 1 (interval 1000), masks on, random background, ssim 0.2; rasterizer gsplat-2dgs; depth distortion 0.01 * D / s from step 3000 (s = scene_scale); normal (centre-depth) consistency 0.05 from step 7500; no jet prior",
   "jet1": "base + Jet2Prior order 1 (S = 0), weight 0.1 from step 7500",
   "jet2": "base + Jet2Prior order 2, weight 0.1 from step 7500"
  },
  "surfel_regularization": "rtgs.render.gsplat_2dgs_backend.SurfelRegularization(depth_distortion, normal_consistency, distortion_start, normal_start, depth_scale=scene_scale[seed]) passed to Trainer.train(surfel_regularization=...): distortion = mean over pixels of gsplat's render_distort (L1 sum_ij w_i w_j |z_i - z_j| in camera depth, mesh units) divided by s; centre-depth consistency = mean over pixels of 1 - n_rendered . (n_from_expected_centre_depth * alpha.detach()); active for step > start.",
  "field_prior": "not used; the arms use rtgs.optim.jet2_prior.Jet2Prior per jet2_prior_configs (driver DriverPrior adds h0/log bookkeeping only)",
  "other": "Exact Trainer values in resolved_training_configs (identical across arms except seed); the 2DGS terms in surfel_regularization_configs (+ scene_scale); the prior in field_prior_configs."
 },
