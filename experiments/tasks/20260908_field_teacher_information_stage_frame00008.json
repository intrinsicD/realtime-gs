  "preprocessing": {
    "downscale": 8,
    "undistort_full_resolution_first": true,
    "target_operator": "Average four bilinear/continuous samples at quarter and three-quarter offsets of each downscaled pixel footprint; same coordinates for photograph image and Gaussian field. Clamp final RGB to [0,1] in every arm. Photographs premultiplied by lossless foreground mask before sampling; fields already fitted to zeroed foreground crop. No field alpha bitmap used.",
    "field_decoder": "GaussianObservationIndexCuda; CPU indexed and direct queries on fixed training samples; max abs error <= 0.00002 CPU/CUDA and <=0.00001 CPU direct/index; decoded sampled tensor error <=0.00002. Fixed-state equal-target loss and gradient exact equality test.",
    "teacher_qualification": "Mean training foreground PSNR >=30dB and mean masked-crop LPIPS <=0.08 for high field vs identically sampled photographs. Failure retained and B/C still run as diagnostic; cannot reject high-fidelity premise on unqualified teacher.",
    "masks": "Only A acquisition/shared init and separate evaluation; B/C fitting scenes have masks=None,use_masks=False.",
    "sample_coordinates": "For output pixel(x,y), average fullres samples at ((x+dx)*8,(y+dy)*8), dx,dy in{0.25,0.75}; edge-origin coordinates. Raw fullres bilinear grid_sample align_corners=False. Output evaluation/hull mask is the average of four samples of fullres binary undistorted mask >=0.5.",
    "parity_samples": {
      "seed_base": 818100,
      "per_view_count": 512,
      "sites": "256 uniform fullcanvas and256 uniform fit-window points using seed_base+view index; add four fit-window boundary corners and points\u00b10.001 from each corner; decoded parity uses first128 output pixels intersecting fit-window."
    },
    "lpips_failure": "Import, cached pretrained alexnet weights and computation must succeed; no alternate backbone, random weights or substitute metric.",
    "index_config": {
      "tile_size": 16,
      "max_entries": 16000000,
      "max_candidates": 200000,
      "max_query_pairs": 1048576,
      "query_chunk": 65536
    }
  },
  "initialization": {
    "method": "Train-mask visual hull boundary on 128 cubed camera/mask-derived bounding cube, requiring positive-depth in-frame foreground in every training view; binary mask threshold0.5, dilation1 output pixel. Select up to20000 shell voxels uniformly by paired seed, isotropic scale one voxel, opacity0.1, colors sampled from reference training images, no heldout data.",
    "minimum_points": 1000,
